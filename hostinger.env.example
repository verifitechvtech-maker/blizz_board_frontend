# ===== Blizz Board frontend on Hostinger =====
#
# A) Deployed as a Node.js Web App from GitHub (Hostinger detects Vite):
#      Root directory : frontend
#      Build command  : npm run build
#      Output folder  : dist
#    Add this environment variable in the Hostinger form BEFORE the first build:
#
# B) Uploaded as files to public_html (File Manager):
#    Hostinger cannot change the address after the build. Put this line in frontend/.env,
#    run  npm run build  , then upload everything inside dist/ (plus the .htaccess file).
#
# Backend address (https://, no / at the end; "/api" is added automatically)
VITE_API_URL=https://<backend-domain>
