{
  "name": "Blizz Board — Task Management",
  "short_name": "Blizz Board",
  "description": "Tasks, meetings (MoM), video calls, chat and reports for your team.",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#edfafd",
  "theme_color": "#123f67",
  "categories": ["productivity", "business"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Tasks", "url": "/dashboard/tasks", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Minutes of Meetings", "short_name": "MoM", "url": "/dashboard/mom", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Chats", "url": "/dashboard/chats", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
